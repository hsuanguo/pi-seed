{
  "name": "pi-seed",
  "version": "0.2.0",
  "description": "My pi setup: extensions and skills as a pi package, plus an installer for packages, settings, and AGENTS.md",
  "license": "MIT",
  "private": true,
  "type": "module",
  "keywords": ["pi-package"],
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": ["./extensions"],
    "skills": ["./skills"]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.0.0",
    "@earendil-works/pi-coding-agent": "1.0.0",
    "@earendil-works/pi-tui": "1.0.2",
    "typebox": "1.3.27",
    "playwright": "1.62.1",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  },
  "scripts": {
    "setup": "node install.mjs",
    "test": "node --test --test-concurrency=4 \"tests/**/*.test.ts\"",
    "test:questionnaire-web": "node tests/browser/ask-user-question.mjs",
    "typecheck": "tsc -p .",
    "check": "npm run typecheck && npm test"
  }
}
